# Copy to backend/.env and set a strong private password
ADMIN_PASSWORD=change-this-to-a-strong-password

# Snappin standalone API integration for photo-completable side quests
# Base URL only (the backend appends /v1/... routes); API key is sent server-to-server in x-api-key.
# SNAPPIN_EVENT_ID must reference an existing Snappin event.
SNAPPIN_API_URL=https://your-snappin-api.example.com
SNAPPIN_API_KEY=replace-with-server-api-key
SNAPPIN_EVENT_ID=replace-with-existing-event-id
