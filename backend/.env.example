# Copy to backend/.env and set a strong private password
ADMIN_PASSWORD=change-this-to-a-strong-password

# Snappin Integration API v1 (server-to-server; never expose this key in the frontend)
# Set SNAPPIN_API_URL to the Snappin Core origin, e.g. https://snappin.example.com
# The backend calls /api/v1/integrations and authenticates with Authorization: Bearer.
# If SNAPPIN_EVENT_ID is empty, Party Casino finds or creates one shared active event
# with externalReference "party-casino:photo-uploads". You can set an existing event ID to use it instead.
SNAPPIN_API_URL=https://your-snappin-core.example.com
SNAPPIN_API_KEY=snappin_replace-with-integration-api-key
SNAPPIN_EVENT_ID=
