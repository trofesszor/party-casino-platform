{
  "name": "party-casino-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace backend run start:dev",
    "dev:frontend": "npm --workspace frontend run dev -- --host 0.0.0.0",
    "build": "npm run build --workspace backend && npm run build --workspace frontend"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
